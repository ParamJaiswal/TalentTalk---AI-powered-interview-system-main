# Google Generative AI API Key
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# AssemblyAI API Key (for cloud-based speech recognition)
# Get your API key from: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ElevenLabs API Key (for text-to-speech)
# Get your API key from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Specific voice ID for ElevenLabs
# Leave blank to use default voice
ELEVENLABS_VOICE_ID=

# Application Settings
# Set to 'production' to enable additional security features
APP_ENV=development
