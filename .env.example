# Google Generative AI API Key (required for primary LLM and embeddings)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (optional - used as fallback for embeddings when Google quota is exceeded)
OPENAI_API_KEY=your_openai_api_key_here

# AssemblyAI API Key (optional - only required for voice interview with AssemblyAI)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ElevenLabs API Key (optional - only required for voice responses)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Notes:
# - Only GOOGLE_API_KEY is strictly required for text-based interviews
# - If Google embeddings quota is exceeded, the system will automatically:
#   1. Try OpenAI embeddings if OPENAI_API_KEY is set
#   2. Fall back to local sentence-transformers embeddings (no API key needed)
# - Voice features require additional API keys (ASSEMBLYAI_API_KEY or ELEVENLABS_API_KEY)
